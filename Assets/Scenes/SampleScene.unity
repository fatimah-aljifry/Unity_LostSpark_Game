  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Correct Answer!\nHere's some fun facts about Saturn:\n\nSaturn has rings;
    the  rings on Saturn are huge. The main rings are the same distance as from the
    Earth to the moon.\n\nSaturn\u2019s rings aren\u2019t solid; they are made up
    of bits of ice, dust and rock. Some of these pieces are smaller than a grain
    of sand while others are taller than skyscrapers!\n\nYou can\u2019t stand on
    Saturn; it is a Gas Giant. This means unlike Earth it doesn\u2019t have a solid
    surface."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
